{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "release-type": "node",
            "draft": true,
            "force-tag-creation": true,
            "include-component-in-tag": false,
            "extra-files": [
                { "type": "json", "path": "sidecar/package.json", "jsonpath": "$.version" },
                { "type": "json", "path": "sidecar/package-lock.json", "jsonpath": "$.version" },
                { "type": "json", "path": "sidecar/package-lock.json", "jsonpath": "$.packages[''].version" }
            ]
        }
    }
}
