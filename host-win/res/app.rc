#pragma code_page(65001)
#include <windows.h>

1 RT_MANIFEST "app.manifest"

// the first icon is the icon of the exe in Explorer
101 ICON "app.ico"

// New Mail, Mark Read and Mark Unread of the toolbar (24x24 each), and the paperclip of the message list.
// Magenta is transparent
201 BITMAP "toolbar.bmp"
202 BITMAP "paperclip.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_COMMAS,0
PRODUCTVERSION APP_VERSION_COMMAS,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Postal Systems OÜ"
            VALUE "FileDescription", "ImapKit Desktop"
            VALUE "FileVersion", APP_VERSION
            VALUE "ProductName", "ImapKit Desktop"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
